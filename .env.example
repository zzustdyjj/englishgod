# 复制为 .env 后填写。LLM_MODEL=mock 时为演示模式（不调用真实模型）。
# 模型名使用 LiteLLM 格式：<厂商>/<模型>，模型必须支持看图。
LLM_MODEL=mock

# 例：Claude
# LLM_MODEL=anthropic/claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...

# 例：通义千问（OpenAI 兼容接口）
# LLM_MODEL=openai/qwen-vl-max
# LLM_API_KEY=sk-...
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

LLM_API_KEY=
LLM_API_BASE=
